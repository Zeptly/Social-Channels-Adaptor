# Zeptly Social — environment contract. Copy to .env for local development.
# NEVER commit real values. In Railway set these as service variables.

NODE_ENV=development

# PostgreSQL (docker compose up -d provides this locally)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zeptly_social

# Shared service credential for Zeptly → Zeptly Social request signing (>= 32 chars).
# Generate: openssl rand -base64 48
ZEPTLY_SERVICE_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Optional: previous secret accepted during rotation.
ZEPTLY_SERVICE_SECRET_PREVIOUS=

# Outstand (server-side only). For local dev without an Outstand account run
# `pnpm dev:mock-outstand` and use the values below.
OUTSTAND_API_KEY=dev-outstand-key
OUTSTAND_WEBHOOK_SECRET=dev-webhook-secret-0123456789
OUTSTAND_API_BASE_URL=http://localhost:4010/v1
OUTSTAND_SCHEDULING_HORIZON_DAYS=30
# Safety margin (minutes) subtracted from the horizon when handing off.
OUTSTAND_HANDOFF_MARGIN_MINUTES=60
# Edit handed-off posts in place via Outstand PATCH /posts/{id} (enable after live verification).
OUTSTAND_POST_UPDATE_ENABLED=false

# Public https origin of the API (Outstand redirects end users back here).
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated Zeptly origins allowed as provisioning returnUrl.
ALLOWED_RETURN_URL_ORIGINS=http://localhost:3000

API_PORT=8080
LOG_LEVEL=info

WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# Opt-in live Outstand test suite (never runs in normal CI).
OUTSTAND_LIVE_TESTS=false
# OUTSTAND_LIVE_API_KEY=
# OUTSTAND_LIVE_ALLOW_PUBLISH=false
# OUTSTAND_LIVE_TEST_ACCOUNT_ID=
